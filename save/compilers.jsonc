{
    "compilers": {
        "GoldSRC": {
            "path": {
                "default": {
                    // Any path value that uses a list has multiple directories that Snark searches for,
                    "win32": ["third_party/StudioMDL/hlsdk.exe"],
                    /*  I was planning on having MacOS support, but I decided against that since A. I don't have a Mac to test it on,
                        and B. Most modding tools that provide support for OSes other than Windows don't support Mac.*/
                    "linux": ["third_party/StudioMDL/hlsdk"]
                }
            },
            "type": "GoldSRC",
            "description": "Cross-platform version of the Half-Life SDK StudioMDL, authored by Valve. Modern compilers are recommended!",
            "capabilities": {
                "fullbright": false,
                "flatshade": false,
                "chromeTRM": false,
                "1024px": false,
                "unlockedChrome": false,
                "noUVshift": false,
                "cliptotextures": true
            },
            "disableEdit": true
        },
        "Svengine": {
            "path": {
                "default": {
                    "win32": [
                        "third_party/StudioMDL/SC.exe"
                    ],
                    "linux": [
                        "third_party/StudioMDL/SC.exe"
                    ]
                }
            },
            "type": "Svengine",
            "description": "Most up-to-date compiler by Sven Co-op team, Linux users are recommended to use Funnky instead.",
            "capabilities": {
                "fullbright": true,
                "flatshade": true,
                "chromeTRM": true,
                "1024px": true,
                "unlockedChrome": true,
                "noUVshift": true,
                "cliptotextures": false
            },
            "disableEdit": true
        },
        "FunnkyHD": {
            "path": {
                "default": {
                    "win32": [
                        "third_party/StudioMDL/funnkySMDL.exe"
                    ],
                    "linux": [
                        "third_party/StudioMDL/funnkySMDL"
                    ]
                }
            },
            "type": "Funnky",
            "description": "Cross-platform compiler with similar features/improvements to Svengine and Xash, authored by FunnkyHD.",
            "capabilities": {
                "fullbright": true,
                "flatshade": true,
                "chromeTRM": true,
                "1024px": true,
                "unlockedChrome": true,
                "noUVshift": true,
                "cliptotextures": false
            },
            "disableEdit": true
        },
        "PrimeXT": {
            "path": {
                "default": {
                    "win32": [
                        "third_party/StudioMDL/pxstudiomdl.exe"
                    ],
                    "linux": [
                        "third_party/StudioMDL/pxstudiomdl"
                    ]
                }
            },
            "type": "Xash3D",
            "description": "Cross-platform compiler for Xash3D (and GoldSRC, but HLAM doesn't like it), authored by SNMetamorph from Flying With Gauss.",
            "capabilities": {
                "fullbright": true,
                "flatshade": true,
                "chromeTRM": true,
                "1024px": true,
                "unlockedChrome": true,
                "noUVshift": true,
                "cliptotextures": false
            },
            "disableEdit": true
        },
        "Sven2018": {
            "path": {
                "default": {
                    "win32": [
                        "third_party/StudioMDL/SC2018.exe"
                    ],
                    "linux": [
                        "third_party/StudioMDL/SC2018.exe"
                    ]
                }
            },
            "type": "Svengine",
            "description": "2018 version of compiler by Sven Co-op team, included due to cbox bug in latest version, Linux users are recommended to use Funnky instead.",
            "capabilities": {
                "fullbright": true,
                "flatshade": true,
                "chromeTRM": true,
                "1024px": true,
                "unlockedChrome": true,
                "noUVshift": true,
                "cliptotextures": false
            },
            "disableEdit": true
        }
    }
}
